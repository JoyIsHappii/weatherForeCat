---
// import type { WeatherData } from '../types/weather';
import { Image } from "astro:assets";
import AppFooter from "./AppFooter.astro";
---

<section class="current-weather-section flex md:h-full w-full">
  <article
    class="hero-card @container relative flex h-full w-full flex-col overflow-hidden p-9 pb-0 md:pb-9"
  >
    <img
      id="hero-bg"
      src="/assets/bg-laptop/Property 1=sunny.svg"
      alt=""
      aria-hidden="true"
class="absolute inset-0 z-0 h-full w-full p-2 object-cover object-top rounded-[80px] md:rounded-t-[80px] md:rounded-b-none shadow-inner shadow-black/50"    />

    <!-- Sizes use cqw (% of the card's content width) so the text and icon scale with the card -->
    <div class="relative z-20 mt-2 flex flex-col items-center">
      <header class="flex items-center justify-center gap-2">
        <button
          id="favorite-toggle"
          class="shrink-0 transition hover:scale-110 hover:opacity-80"
          aria-label="Toggle Favorite"
        >
          <img
            id="fav-icon-default"
            src="/assets/icons/fav=default.svg"
            alt="Favorite Icon"
            class="size-[clamp(2rem,10cqw,2.75rem)] object-contain"
          />
          <img
            id="fav-icon-active"
            src="/assets/icons/fav=blue-clicked.svg"
            alt="Favorited Icon"
            class="hidden size-[clamp(2rem,10cqw,2.75rem)] object-contain"
          />
        </button>
        <h2
          id="hero-city-name"
          class="text-[clamp(1.5rem,10cqw,2.5rem)] leading-tight font-medium tracking-tight opacity-80 text-center"
        >
          Vancouver
        </h2>
      </header>

      <!-- Temperature + icon stay together, centered. md–lg the card is narrow, so they stack. -->
      <div
        class="mt-4 flex items-center justify-center gap-[2cqw] md:flex-col md:gap-0 xl:flex-row xl:gap-[2cqw]"
      >
        <div class="flex flex-col items-start md:items-center xl:items-start">
          <h1 class="text-[clamp(3rem,20cqw,5rem)] leading-none font-semibold tracking-tighter opacity-80">
            <span id="hero-temp-main">18</span>
          </h1>
          <p class="mt-2 text-[clamp(0.875rem,5cqw,1.125rem)] opacity-70">
            <span id="top-date-time">Mon Date, Time</span>
          </p>
          <div class="mt-1 flex items-center gap-3 text-[clamp(0.875rem,5cqw,1.125rem)] opacity-80">
            <span class="flex items-center gap-1">
              <img src="/assets/icons/umbrella.svg" class="size-[1em] opacity-80" alt="Rain" />
              <span id="hero-precipitation">10%</span>
            </span>
            <span class="text-slate-400">|</span>
            <span class="flex items-center gap-1">
              <img src="/assets/icons/famicons_snow.svg" class="size-[1em] opacity-80" alt="Snow" />
              <span id="hero-snowfall">10%</span>
            </span>
          </div>
        </div>

        <div class="size-[clamp(6.5rem,38cqw,12rem)] shrink-0 drop-shadow-md md:size-[clamp(6rem,50cqw,9rem)] xl:size-[clamp(6.5rem,38cqw,12rem)]">
          <img
            id="hero-weather"
            src=""
            alt="Current Weather"
            class="h-full w-full object-contain"
          />
        </div>
      </div>
    </div>

    <!-- Mobile: sits right under the weather and ends the card. md: above the footer (content is stacked, too tall for the hill).
		     xl: feet on the background hill, which scales with card width (~100cqw from the top). -->
<div
  class="relative z-10 mx-auto -mt-2 w-3/4 max-w-64 pointer-events-none md:absolute md:mt-0 md:left-1/2 md:-translate-x-1/2 md:bottom-36 md:w-3/5 xl:bottom-auto xl:top-[75cqw] xl:w-[70cqw]"
>
<img
  id="cat-mascot"
  src=""
  alt="Str Cats Mascot"
  class="h-auto w-full object-contain drop-shadow-xl animate-float"
/>
</div>

    <!-- Mobile shows the footer at the bottom of the page instead (index.astro) -->
    <AppFooter logoId="footer-logo" class="mt-auto hidden md:flex" />
  </article>
</section>
