---
// src/components/HoursCard.astro
---

<div
  class="bg-white/90 backdrop-blur-md font-roboto rounded-4xl p-5 shadow-inner shadow-black/50 w-full mt-6 short:mt-3 md:flex-1 md:min-h-0 flex flex-col"
>
  <h3
    id="hourly-title"
    class="text-xl lg:text-2xl font-bold text-gray-700 tracking-tight mb-4 text-center"
  >
    3 Hour Forecast
  </h3>

  <div
    id="hourly-range-container"
    class="flex flex-col w-full divide-y divide-gray-200/90 flex-1 justify-between"
  >
    {
      Array.from({ length: 8 }).map(() => (
        <div class="hour-item flex items-center justify-between px-1 w-full">
          <div class="hour-time text-xl w-1/3  shrink-0">
            --:--
          </div>

          <div class="hour-emoji flex-1 w-1/3 flex items-center justify-center">
            <div class="w-full h-full aspect-square flex items-center justify-center"></div>
          </div>

          <div class="hour-temp text-xl w-1/3  text-right shrink-0">
            --°
          </div>
        </div>
      ))
    }
  </div>
</div>
